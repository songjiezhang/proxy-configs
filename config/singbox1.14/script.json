/*
 * sing-box 1.14 / Sub-Store 节点替换脚本
 *
 * 参数：
 * type=组合订阅
 * name=自建订阅
 *
 * 可选：
 * service_password=xxx
 * clash_password=xxx
 *
 * 功能：
 * 1. 获取 Sub-Store 订阅节点
 * 2. 删除模板中的旧代理节点
 * 3. 自动选择：包含全部订阅节点
 * 4. 手动选择：包含全部订阅节点
 * 5. 默认代理：自动选择 + 手动选择
 * 6. 保留 DNS、route、TUN 等其他配置
 */

const args = $arguments || {};

const subscriptionName = args.name || "自建订阅";

const subscriptionType =
  /^(1|col|collection|组合订阅)$/i.test(args.type || "")
    ? "collection": "subscription";

const servicePassword = args.service_password;
const clashPassword = args.clash_password;

const selectorTag = "默认代理";
const autoTag = "自动选择";
const manualTag = "手动选择";
const directTag = "直连";

// 模板中需要替换的旧节点
const oldNodeTags = [
  "ZJ-US-AnyTLS",
  "ZJ-US-Hysteria2"
];

// 排除无效节点
const excludeRegex =
  /官网|剩余|流量|套餐|免费|订阅|到期|直连|Expire|Traffic|GB/i;

function log(message) {
  console.log("[sing-box 1.14] " + message);
}
// 读取模板配置
const parser = ProxyUtils.JSON5 || JSON;
const config = parser.parse($content ?? $files[
  0
]);

if (!Array.isArray(config.outbounds)) {
  throw new Error("模板缺少 outbounds");
}
// 获取 Sub-Store 订阅
log("正在读取订阅：" + subscriptionName);

const result = await produceArtifact({
  name: subscriptionName,
  type: subscriptionType,
  platform: "sing-box"
});

const data =
  typeof result === "string"
    ? JSON.parse(result)
    : result;

if (!data || !Array.isArray(data.outbounds)) {
  throw new Error("无法读取订阅节点");
}
// 支持的代理协议
const proxyTypes = new Set([
  "shadowsocks",
  "vmess",
  "vless",
  "trojan",
  "hysteria",
  "hysteria2",
  "tuic",
  "anytls",
  "ssh",
  "shadowtls",
  "http",
  "socks",
  "wireguard",
  "naive"
]);

// 获取模板已有的出站名称
const reservedTags = new Set(
  config.outbounds
    .filter(item => !oldNodeTags.includes(item.tag))
    .map(item => item.tag)
);

const usedTags = new Set(reservedTags);
const nodes = [];

// 过滤订阅节点并处理重名
for (const node of data.outbounds) {
  if (
    !node ||
    !node.tag ||
    !proxyTypes.has(node.type) ||
    excludeRegex.test(node.tag)
  ) {
    continue;
  }

  const copy = { ...node
  };
  const originalTag = copy.tag;
  let suffix = 2;

  while (usedTags.has(copy.tag)) {
    copy.tag = originalTag + "-" + suffix++;
  }

  usedTags.add(copy.tag);
  nodes.push(copy);
}

if (nodes.length === 0) {
  throw new Error("订阅中没有可用的代理节点");
}

log("有效节点数量：" + nodes.length);

// 删除模板旧节点
config.outbounds = config.outbounds.filter(
  item => !oldNodeTags.includes(item.tag)
);

// 获取策略组
const selector = config.outbounds.find(
  item => item.tag === selectorTag
);

const autoSelector = config.outbounds.find(
  item => item.tag === autoTag
);

let manualSelector = config.outbounds.find(
  item => item.tag === manualTag
);

// 检查默认代理
if (!selector || selector.type !== "selector") {
  throw new Error("找不到默认代理 selector");
}
// 检查自动选择
if (!autoSelector || autoSelector.type !== "urltest") {
  throw new Error("找不到自动选择 urltest");
}
// 如果模板中没有手动选择则自动创建
if (!manualSelector) {
  manualSelector = {
    tag: manualTag,
    type: "selector",
    outbounds: []
  };

  config.outbounds.push(manualSelector);
}

if (manualSelector.type !== "selector") {
  throw new Error("手动选择必须是 selector 类型");
}
// 获取所有订阅节点名称
const nodeTags = nodes.map(node => node.tag);

// 默认代理：自动 + 手动
selector.outbounds = [autoTag, manualTag
];
selector.default = autoTag;

// 自动选择：全部订阅节点
autoSelector.outbounds = [...nodeTags
];

// 手动选择：全部订阅节点
manualSelector.outbounds = [...nodeTags
];

// 清理手动选择无效的默认节点
if (
  manualSelector.default &&
  !nodeTags.includes(manualSelector.default)
) {
  delete manualSelector.default;
}
// 添加订阅节点到 outbounds
config.outbounds.push(...nodes);

// 确认直连存在
if (!config.outbounds.some(
  item => item.tag === directTag
)) {
  throw new Error("模板缺少直连出口");
}
// 修改 API Service 密码
if (
  servicePassword !== undefined &&
  servicePassword !== "" &&
  Array.isArray(config.services)
) {
  for (const service of config.services) {
    if (service.type === "api") {
      service.secret = String(servicePassword);
    }
  }
}
// 修改 Clash API 密码
if (
  clashPassword !== undefined &&
  clashPassword !== "" &&
  config.experimental?.clash_api
) {
  config.experimental.clash_api.secret =
    String(clashPassword);
}
// 输出完整配置
$content = JSON.stringify(config,
null,
2);

log("配置生成成功");
log("默认代理：" + selector.outbounds.join(", "));
log("自动选择节点：" + nodeTags.length);
log("手动选择节点：" + nodeTags.length);
